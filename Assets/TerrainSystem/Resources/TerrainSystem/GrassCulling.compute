#pragma kernel CSMain

StructuredBuffer<float4x4> _SourceMatrices;
AppendStructuredBuffer<float4x4> _VisibleMatrices;
float3 _CameraPosition;
float4 _FrustumPlanes[6];
float _MaxDistance;
float _InstanceDensity;
float _InstanceRadius;

[numthreads(64, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= _SourceMatrices.Length) return;
    float4x4 transformMatrix = _SourceMatrices[index];
    float3 position = float3(transformMatrix[0][3], transformMatrix[1][3], transformMatrix[2][3]);
    if (distance(position, _CameraPosition) > _MaxDistance) return;
    for (int planeIndex = 0; planeIndex < 6; planeIndex++)
        if (dot(_FrustumPlanes[planeIndex].xyz, position) + _FrustumPlanes[planeIndex].w < -_InstanceRadius) return;
    float selection = frac(sin((float)index * 12.9898) * 43758.5453);
    if (selection > _InstanceDensity) return;
    _VisibleMatrices.Append(transformMatrix);
}
